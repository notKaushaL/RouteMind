# RouteMind Environment Template
# Copy to .env and fill in secrets before running

# PostgreSQL
POSTGRES_PASSWORD=routemind_dev

# Redis
REDIS_URL=redis://localhost:6379/0

# OSRM (local Docker)
OSRM_URL=http://localhost:5000

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001

# DVC remote (optional — S3 / GCS path)
# DVC_REMOTE_URL=s3://your-bucket/routemind-dvc

# Vadodara bounding box (OSMnx download)
VADODARA_NORTH=22.4
VADODARA_SOUTH=22.2
VADODARA_EAST=73.3
VADODARA_WEST=73.1
