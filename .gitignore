# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/
*.pyi

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env
!.env.example

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.iml

# ── Data & Models (tracked via DVC, NOT Git) ──────────────────────────────────
data/raw/*
data/processed/*
data/synthetic/*
data/features/*
data/osrm/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep
!data/features/.gitkeep
!data/osrm/.gitkeep

# ── Large geospatial artifacts ────────────────────────────────────────────────
*.graphml
*.osm
*.osm.pbf

# ── Trained models ────────────────────────────────────────────────────────────
*.pkl
*.joblib
*.pt
*.pth
*.ckpt
ml/*/models/
ml/*/runs/

# ── Database files ────────────────────────────────────────────────────────────
*.duckdb
*.duckdb.wal
*.db

# ── DVC ───────────────────────────────────────────────────────────────────────
.dvc/cache/
.dvc/tmp/
/tmp/

# ── MLflow ────────────────────────────────────────────────────────────────────
mlruns/
mlartifacts/

# ── Reports (generated) ───────────────────────────────────────────────────────
reports/*.html
reports/*.json
!reports/.gitkeep

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Docker ───────────────────────────────────────────────────────────────────
*.log

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
